rules_version = '2';

// Plastic Pulse. Everything is closed unless a rule below opens it.
// Players are signed in anonymously (no name, no email).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isGoogle() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com'; }

    // Young players: no email addresses, phone numbers or links in free text.
    function noContact(t) {
      return !t.matches('(?s).*[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}.*')
        && !t.matches('(?s).*[0-9][0-9 ()+.-]{6,}[0-9].*')
        && !t.matches('(?si).*(https?://|www[.]).*');
    }

    // Keep in sync with src/services/sharedGoal.ts and src/data/content.ts.
    function maxGramsPerChoice() { return 50; }
    function maxGramsPerPlayerWeek() { return 500; }
    function secondsBetweenChoices() { return 3; }
    function targetGrams() { return 20000; }

    function validDelta(d) { return d is number && d > 0 && d <= maxGramsPerChoice(); }

    // Weekly shared goal: goals/{week}, week like "2026-W44".
    match /goals/{week} {
      function goalPath() { return /databases/$(database)/documents/goals/$(week); }
      function playerPath() { return /databases/$(database)/documents/goals/$(week)/players/$(request.auth.uid); }
      function gramsBefore(path) { return exists(path) ? get(path).data.grams : 0; }
      // The player's own record must grow by the same amount in the same batch.
      function playerGrewBy(d) { return getAfter(playerPath()).data.grams - gramsBefore(playerPath()) == d; }

      allow read: if signedIn();

      allow create: if signedIn()
        && week.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['grams', 'targetGrams'])
        && request.resource.data.targetGrams == targetGrams()
        && validDelta(request.resource.data.grams)
        && playerGrewBy(request.resource.data.grams);

      // targetGrams may only move to the current target (a week started under an older goal catches up).
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grams', 'targetGrams'])
        && request.resource.data.targetGrams == targetGrams()
        && validDelta(request.resource.data.grams - resource.data.grams)
        && playerGrewBy(request.resource.data.grams - resource.data.grams);

      // One player's part of the week. Only that player can see it: no public individual rankings.
      // Anti-spam: at most maxGramsPerPlayerWeek() per player per week, and one choice every few seconds.
      match /players/{uid} {
        function playerDelta() {
          return request.resource.data.grams - (resource == null ? 0 : resource.data.grams);
        }
        function cooledDown() {
          return resource == null || resource.data.get('at', null) == null
            || request.time > resource.data.at + duration.value(secondsBetweenChoices(), 's');
        }
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['grams', 'at'])
          && request.resource.data.at == request.time
          && cooledDown()
          && validDelta(playerDelta())
          && request.resource.data.grams <= maxGramsPerPlayerWeek()
          && getAfter(goalPath()).data.grams - gramsBefore(goalPath()) == playerDelta();
      }
    }

    // Saved progress for players signed in with Google: only that player can read or write it.
    // The game state is stored as one JSON string; no name or email is ever stored here.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && isGoogle()
        && request.resource.data.keys().hasOnly(['state', 'updatedAt'])
        && request.resource.data.state is string
        && request.resource.data.state.size() <= 900000
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid; // "Delete my data"
    }

    // ---- Community ideas (Solution Lab) ----
    // Ideas appear right away: creativity never waits for approval. Adults step in afterwards:
    // a teacher can hide any idea in their class; the moderator (admins/{uid}, set in the Firebase console)
    // can hide or restore community ideas. Players can report an idea; three reports hide it until an adult looks.
    // Public ideas: ideas/{id}. Class ideas: groups/{gid}/ideas/{id} (only classmates and the teacher see them).
    // Keep the word list and limits in sync with src/services/ideas.ts.
    function isAdmin() { return isGoogle() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function noBadWords(t) {
      return !t.matches('(?is).*\\b(fuck|shit|bitch|cunt|dick|pussy|asshole|bastard|slut|whore|nigg|fag|retard|puta|mierda|pendej|cabron|verga|chinga|coño|culero|marica).*');
    }
    function ideaText(t, min, max) { return t is string && t.size() >= min && t.size() <= max && noContact(t) && noBadWords(t); }
    function pitcherPath() { return /databases/$(database)/documents/pitchers/$(request.auth.uid); }
    // One new idea per minute per player, recorded in pitchers/{uid} in the same batch.
    function pitchPaced() {
      return getAfter(pitcherPath()).data.at == request.time
        && (!exists(pitcherPath()) || request.time > get(pitcherPath()).data.at + duration.value(60, 's'));
    }
    function newIdea() {
      return request.resource.data.keys().hasOnly(['problemId', 'title', 'problem', 'idea', 'evidence', 'uid', 'status', 'votes', 'reports', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.problemId is string && request.resource.data.problemId.size() <= 40
        && ideaText(request.resource.data.title, 4, 80)
        && ideaText(request.resource.data.problem, 0, 400)
        && ideaText(request.resource.data.idea, 11, 600)
        && ideaText(request.resource.data.evidence, 0, 400)
        && request.resource.data.status == 'visible'
        && request.resource.data.votes == 0
        && request.resource.data.reports == 0
        && request.resource.data.createdAt == request.time
        && pitchPaced();
    }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // An adult hides or restores an idea (restoring clears its reports).
    function adultSets() {
      return onlyChanged(['status', 'reports']) && request.resource.data.status in ['visible', 'hidden']
        && (request.resource.data.status == 'hidden' || request.resource.data.reports == 0);
    }
    function voteChanged(votePath) {
      return onlyChanged(['votes']) && resource.data.status == 'visible' && (
        (request.resource.data.votes == resource.data.votes + 1 && !exists(votePath) && existsAfter(votePath))
        || (request.resource.data.votes == resource.data.votes - 1 && exists(votePath) && !existsAfter(votePath)));
    }
    // A report adds one, together with the reporter's own report doc; the third report hides the idea.
    function reported(reportPath) {
      return onlyChanged(['reports', 'status']) && resource.data.status == 'visible'
        && request.resource.data.reports == resource.data.reports + 1 && !exists(reportPath) && existsAfter(reportPath)
        && request.resource.data.status == (request.resource.data.reports >= 3 ? 'hidden' : 'visible');
    }
    function stamp() { return request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time; }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    match /pitchers/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid && stamp();
    }

    match /ideas/{id} {
      function mine(kind) { return /databases/$(database)/documents/ideas/$(id)/$(kind)/$(request.auth.uid); }
      allow read: if signedIn() && (resource.data.status == 'visible' || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && newIdea();
      allow update: if signedIn() && ((isAdmin() && adultSets()) || voteChanged(mine('votes')) || reported(mine('reports')));
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      match /votes/{uid} {
        function idea() { return /databases/$(database)/documents/ideas/$(id); }
        allow get: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && stamp() && getAfter(idea()).data.votes == get(idea()).data.votes + 1;
        allow delete: if signedIn() && request.auth.uid == uid && getAfter(idea()).data.votes == get(idea()).data.votes - 1;
      }
      match /reports/{uid} {
        function idea() { return /databases/$(database)/documents/ideas/$(id); }
        allow get: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && stamp() && getAfter(idea()).data.reports == get(idea()).data.reports + 1;
      }
    }

    // Anonymous tally of scanned items that aren't in the Specimen Book yet (label and material only,
    // never a photo or player id). Players can only add one at a time; only moderators read it.
    match /scanTally/{slug} {
      allow read: if isAdmin();
      allow create: if signedIn() && slug.matches('^[a-z0-9-]{1,50}$')
        && request.resource.data.keys().hasOnly(['label', 'material', 'count'])
        && request.resource.data.count == 1
        && request.resource.data.label is string && request.resource.data.label.size() >= 1 && request.resource.data.label.size() <= 60
        && noContact(request.resource.data.label) && noBadWords(request.resource.data.label)
        && request.resource.data.material in ['PET', 'HDPE', 'PVC', 'LDPE', 'PP', 'PS', 'OTHER', 'MULTILAYER', 'NONE', 'UNKNOWN'];
      allow update: if signedIn() && onlyChanged(['count']) && request.resource.data.count == resource.data.count + 1;
    }

    // City lights on the globe: lights/{week}/cities/{key}, e.g. key "US-los-angeles".
    // A city grows only together with a player's own capped part of the world goal (same batch).
    // Only a rough city is stored (from /api/where): never a player id, GPS or anything personal.
    match /lights/{week}/cities/{key} {
      function playerPath() { return /databases/$(database)/documents/goals/$(week)/players/$(request.auth.uid); }
      function playerDelta() { return getAfter(playerPath()).data.grams - (exists(playerPath()) ? get(playerPath()).data.grams : 0); }
      function delta() { return request.resource.data.grams - (resource == null ? 0 : resource.data.grams); }
      function place() {
        let d = request.resource.data;
        return d.name is string && d.name.size() >= 1 && d.name.size() <= 60 && noContact(d.name) && noBadWords(d.name)
          && d.country is string && d.country.matches('^[A-Z]{2}$') && key.matches('^' + d.country + '-[a-z0-9-]{1,40}$')
          && d.lat is number && d.lat >= -90 && d.lat <= 90 && d.lng is number && d.lng >= -180 && d.lng <= 180;
      }
      allow read: if signedIn();
      allow create: if signedIn() && week.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['grams', 'name', 'country', 'lat', 'lng'])
        && place() && validDelta(delta()) && delta() == playerDelta();
      allow update: if signedIn() && onlyChanged(['grams']) && validDelta(delta()) && delta() == playerDelta();
    }

    // Groups: a class (made by a teacher) or, later, a household. Members join with a short code.
    // Members are anonymous: the owner sees how many joined and the group's total, never who did what.
    // Keep codes and goals in sync with src/services/groups.ts.
    function validCode(c) { return c is string && c.matches('^[A-HJ-NP-Z2-9]{6}$'); }
    function groupTarget(kind) { return kind == 'class' ? 3000 : 1000; }

    match /codes/{code} {
      allow get: if signedIn();
      // Made in the same batch as its group, by the group's owner. Never overwritten.
      allow create: if isGoogle() && validCode(code)
        && request.resource.data.keys().hasOnly(['groupId'])
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.code == code;
    }

    match /groups/{gid} {
      function groupPath() { return /databases/$(database)/documents/groups/$(gid); }
      function isOwner() { return signedIn() && get(groupPath()).data.ownerUid == request.auth.uid; }
      function isMember() { return signedIn() && exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)); }

      allow get: if signedIn();
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid; // a teacher's own classes
      allow create: if isGoogle()
        && request.resource.data.keys().hasOnly(['name', 'kind', 'code', 'ownerUid', 'targetGrams', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.kind in ['class', 'household']
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
        && noContact(request.resource.data.name)
        && validCode(request.resource.data.code)
        && existsAfter(/databases/$(database)/documents/codes/$(request.resource.data.code))
        && request.resource.data.targetGrams == groupTarget(request.resource.data.kind)
        && request.resource.data.createdAt == request.time;

      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isOwner());
        allow list: if isOwner();
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['joinedAt'])
          && request.resource.data.joinedAt == request.time;
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner());
      }

      // The group's weekly total. It grows only together with the member's own capped part of the world goal.
      match /weeks/{week} {
        function playerPath() { return /databases/$(database)/documents/goals/$(week)/players/$(request.auth.uid); }
        function playerDelta() { return getAfter(playerPath()).data.grams - (exists(playerPath()) ? get(playerPath()).data.grams : 0); }
        function delta() { return request.resource.data.grams - (resource == null ? 0 : resource.data.grams); }
        allow read: if isMember() || isOwner();
        allow create, update: if isMember()
          && week.matches('^[0-9]{4}-W[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['grams'])
          && validDelta(delta())
          && delta() == playerDelta();
      }

      // Class ideas: classmates see them right away; the teacher sees every idea and can hide or restore one.
      match /ideas/{id} {
        function mine(kind) { return /databases/$(database)/documents/groups/$(gid)/ideas/$(id)/$(kind)/$(request.auth.uid); }
        allow read: if (isMember() && resource.data.status == 'visible') || (signedIn() && resource.data.uid == request.auth.uid) || isOwner();
        allow create: if isMember() && newIdea();
        allow update: if (isOwner() && adultSets()) || (isMember() && (voteChanged(mine('votes')) || reported(mine('reports'))));
        allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isOwner();
        match /votes/{uid} {
          function idea() { return /databases/$(database)/documents/groups/$(gid)/ideas/$(id); }
          allow get: if signedIn() && request.auth.uid == uid;
          allow create: if isMember() && request.auth.uid == uid && stamp() && getAfter(idea()).data.votes == get(idea()).data.votes + 1;
          allow delete: if signedIn() && request.auth.uid == uid && getAfter(idea()).data.votes == get(idea()).data.votes - 1;
        }
        match /reports/{uid} {
          function idea() { return /databases/$(database)/documents/groups/$(gid)/ideas/$(id); }
          allow get: if signedIn() && request.auth.uid == uid;
          allow create: if isMember() && request.auth.uid == uid && stamp() && getAfter(idea()).data.reports == get(idea()).data.reports + 1;
        }
      }
    }

    // Player feedback: players can add, nobody can read or change it from the app.
    // Read it in the Firebase console. Keep FEEDBACK_MAX and the contact patterns in sync with src/services/feedback.ts.
    match /feedback/{id} {
      function shortText(t) { return t is string && t.size() <= 1000 && noContact(t); }
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'liked', 'confusing', 'comeBack', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && shortText(request.resource.data.liked)
        && shortText(request.resource.data.confusing)
        && request.resource.data.comeBack in ['yes', 'maybe', 'no', '']
        && request.resource.data.createdAt == request.time;
    }
  }
}
