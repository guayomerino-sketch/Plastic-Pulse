# Copy this file to .env.local
# Never put an AI API key in a VITE_ variable: it would be visible to anyone.

# AI scanner (server only, never VITE_): set in Vercel → Settings → Environment Variables,
# or in .env.local to test locally. Create it at console.anthropic.com and set a monthly spend limit there.
ANTHROPIC_API_KEY=
# Optional: ANTHROPIC_MODEL=claude-opus-5-5
