# Copy this file to .env.local
# Never put a Gemini API key in this app: it would be visible to anyone.

# AI scanner (server only, never VITE_): set in Vercel → Settings → Environment Variables,
# or in .env.local to test locally. Use a key from a Google project WITHOUT billing so it can't be charged.
GEMINI_API_KEY=
# Optional: GEMINI_MODEL=gemini-flash-latest
